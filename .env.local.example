# Kiosk App — Environment Variables
# Copy this file to .env and fill in all values before running.

# Database

# Kiosk app PostgreSQL database connection. Get this from your kiosk database provider or local PostgreSQL administrator. Expected format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE.
DATABASE_URL="<kiosk-postgresql-connection-url>"

# Read-only OS4 PostgreSQL database connection. Request a dedicated read-only credential from the OS4 team. Expected format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE.
OS4_DATABASE_URL="<os4-read-only-postgresql-connection-url>"

# Authentication

# Secret used to sign JWT session cookies. Generate it with a cryptographically secure secret generator. Expected format: a random string containing at least 32 characters.
JWT_SECRET="<random-secret-at-least-32-characters>"

# Initial/fallback PIN used by authorized staff to administer the kiosk. Choose this according to your organization's credential policy. Expected format: a numeric PIN stored as a string.
ADMIN_PIN="<secure-numeric-admin-pin>"

# Email

# API key used to send OTP and check-in emails. Create or copy it from the Resend dashboard under API Keys. Expected format: a Resend API key string.
RESEND_API_KEY="<resend-api-key>"

# Verified sender address used for outgoing emails. Configure and verify the address or domain in the Resend dashboard. Expected format: a valid email address on a verified sending domain.
RESEND_FROM_EMAIL="<verified-sender-email-address>"

# Optional test recipient that overrides the mentor address for check-in notifications. Use a controlled test mailbox; leave empty to send to the assigned mentor. Expected format: a valid email address or an empty value.
CHECKIN_NOTIFICATION_RECIPIENT=

# Optional test recipient that overrides the requesting user's address for OTP delivery. Use a controlled test mailbox; leave empty to send to the requesting user. Expected format: a valid email address or an empty value.
OTP_NOTIFICATION_RECIPIENT=

# A
