# ============================================================
# KIOSK APP — Docker Environment Variables
# ============================================================
# Copy this file to .env and fill in all values.
# Then run: docker compose up --build
#
# REQUIRED: OS4's database must be running before starting this app.
# See OS4_DATABASE_URL below.
# Do not add inline comments after values in the completed .env file.
# ============================================================

# --- Kiosk database (managed by Docker Compose — kiosk-db service) ---
# These must match the values in docker-compose.yml.
POSTGRES_USER=kioskuser
POSTGRES_PASSWORD=CHOOSE_A_STRONG_PASSWORD
POSTGRES_DB=kiosk
DATABASE_URL=postgresql://kioskuser:CHOOSE_A_STRONG_PASSWORD@kiosk-db:5432/kiosk
# Use "kiosk-db" as the host (Docker Compose service name), not "localhost".

# --- OS4 database (EXTERNAL — not managed here) ---
# This app reads user and booking data from OS4's database.
# OS4 must be running separately before starting this app.
#
# If OS4 is running on the same machine:
# OS4_DATABASE_URL=postgresql://postgres:PASSWORD@host.docker.internal:PORT/schedule_optimizer?schema=public
#
# If OS4 is hosted externally:
# OS4_DATABASE_URL=postgresql://user:pass@hostname:5432/schedule_optimizer?schema=public
OS4_DATABASE_URL=REQUIRED_OS4_CONNECTION_STRING

# --- Authentication ---
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Used only on the first seed; use the same PIN for subsequent starts.
ADMIN_PIN=REPLACE_WITH_A_SECURE_NUMERIC_PIN

# --- Email (Resend) ---
# Get your API key from https://resend.com/api-keys.
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=verified-sender@example.com
# Optional controlled inboxes for testing; leave empty for real recipients.
CHECKIN_NOTIFICATION_RECIPIENT=
OTP_NOTIFICATION_RECIPIENT=

# --- App config ---
CLIENT_URL=http://localhost:3000
